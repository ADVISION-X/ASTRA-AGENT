{
  "name": "grasseye-local-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "GrassEye phase-three real-platform local workbench",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/app/server.js",
    "grasseye:start": "node scripts/startup/launch-grasseye.mjs",
    "dev": "tsx src/app/server.ts",
    "audit:build": "tsx scripts/audit/build-audit-artifacts.ts",
    "audit": "tsx scripts/audit/runner.ts",
    "audit:agent-mechanical-skills": "tsx scripts/audit/domains/agent-mechanical-skills/run-inspector.ts",
    "audit:local-ai-runtime": "tsx scripts/audit/domains/local-ai-runtime/run-inspector.ts",
    "acceptance:local-ai-health": "npm run build && node scripts/acceptance/local-ai-health.mjs",
    "acceptance:browse-live-proof": "npm run build && GRASSEYE_PLATFORM_TARGET=tiktok-web node scripts/acceptance/browse-live-proof.mjs",
    "acceptance:delivery-smoke": "npm run build && GRASSEYE_PLATFORM_TARGET=tiktok-web node scripts/acceptance/delivery-smoke.mjs",
    "acceptance:phase3": "npm run ci:full && npm run acceptance:browse-live-proof && npm run acceptance:delivery-smoke",
    "ci:full": "npm run typecheck && npm run audit:build && npm run audit",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
