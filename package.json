{
  "name": "grasseye-local-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "GrassEye phase-five final-delivery debugging local workbench",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "internal:app-server": "node dist/src/app/server.js",
    "grasseye:start": "node scripts/startup/launch-grasseye.mjs",

    "internal:app-server:dev": "tsx src/app/server.ts",

    "audit:code-purity": "node --import tsx scripts/audit/domains/code-purity/run-inspector.ts",
    "audit:runtime-logging": "node --import tsx scripts/audit/domains/runtime-logging/run-inspector.ts",
    "audit:quality-kernel": "node --import tsx scripts/audit/domains/quality-kernel/run-inspector.ts",
    "audit:audit-system": "node --import tsx scripts/audit/domains/audit-system/run-inspector.ts",
    "audit:pure-visual-round": "node --import tsx scripts/audit/domains/pure-visual-round/run-inspector.ts",
    "audit:dom-automation": "node --import tsx scripts/audit/domains/dom-automation/run-inspector.ts",
    "ci:full": "node --import tsx scripts/audit/ci-full.ts",

    "acceptance:delivery-smoke": "npm run build && GRASSEYE_PLATFORM_TARGET=tiktok-web node scripts/acceptance/delivery-smoke.mjs",
    "acceptance:dom-automation-smoke": "node --import tsx scripts/acceptance/dom-automation-smoke.ts",
    "acceptance:amazon-invoice-agent-start-smoke": "node --import tsx scripts/acceptance/amazon-invoice-agent-start-smoke.ts",
    "acceptance:amazon-invoice-upload-complete-smoke": "node --import tsx scripts/acceptance/amazon-invoice-upload-complete-smoke.ts",
    "acceptance:amazon-invoice-upload-smoke": "node --import tsx scripts/acceptance/amazon-invoice-upload-smoke.ts",

    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@img/sharp-darwin-arm64": "^0.34.5",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
