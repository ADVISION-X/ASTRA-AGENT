{
  "name": "grasseye-local-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "GrassEye phase-four full-enforcement local workbench",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "internal:app-server": "node dist/src/app/server.js",
    "grasseye:start": "node scripts/startup/launch-grasseye.mjs",
    "internal:app-server:dev": "GRASSEYE_PLATFORM_TARGET=tiktok-web tsx src/app/server.ts",
    "audit:build": "node --import tsx scripts/audit/build-audit-artifacts-cli.ts",
    "audit": "node --import tsx scripts/audit/runner.ts",
    "audit:ai": "tsx scripts/audit/domains/ai-capability/run-inspector.ts",
    "audit:code-purity": "node --import tsx scripts/audit/domains/code-purity/run-inspector.ts",
    "audit:orchestration": "node --import tsx scripts/audit/domains/orchestration-capability/run-inspector.ts",
    "audit:nerve-bus": "tsx scripts/audit/domains/nerve-bus-capability/run-inspector.ts",
    "audit:capability-runtime-wiring": "tsx scripts/audit/domains/capability-runtime-wiring/run-inspector.ts",
    "audit:text-input-capability": "tsx scripts/audit/domains/text-input-capability/run-inspector.ts",
    "audit:map-plugin-package": "tsx scripts/audit/domains/map-plugin-package/run-inspector.ts",
    "audit:map-prompt-contract": "tsx scripts/audit/domains/map-prompt-contract/run-inspector.ts",
    "audit:runtime-debug-transparency": "tsx scripts/audit/domains/runtime-debug-transparency/run-inspector.ts",
    "audit:commander-console": "node --import tsx scripts/audit/domains/commander-console-capability/run-inspector.ts",
    "audit:commander-console-user-love": "tsx scripts/audit/domains/commander-console-user-love/run-inspector.ts",
    "audit:agent-mechanical-skills": "tsx scripts/audit/domains/agent-mechanical-skills/run-inspector.ts",
    "audit:local-ai-runtime": "tsx scripts/audit/domains/local-ai-runtime/run-inspector.ts",
    "audit:forensics-persistence": "tsx scripts/audit/domains/forensics-persistence-capability/run-inspector.ts",
    "audit:page-state": "node --import tsx scripts/audit/domains/page-state-capability/run-inspector.ts",
    "audit:visual-target": "node --import tsx scripts/audit/domains/visual-target-capability/run-inspector.ts",
    "audit:screenshot": "node --import tsx scripts/audit/domains/screenshot-capability/run-inspector.ts",
    "audit:geometry-guard": "node --import tsx scripts/audit/domains/geometry-guard-capability/run-inspector.ts",
    "audit:open": "node --import tsx scripts/audit/domains/open-capability/run-inspector.ts",
    "audit:mouse-click": "node --import tsx scripts/audit/domains/mouse-click-capability/run-inspector.ts",
    "acceptance:local-ai-health": "npm run build && node scripts/acceptance/local-ai-health.mjs",
    "acceptance:browse-live-proof": "npm run build && GRASSEYE_PLATFORM_TARGET=tiktok-web node scripts/acceptance/browse-live-proof.mjs",
    "acceptance:delivery-smoke": "npm run build && GRASSEYE_PLATFORM_TARGET=tiktok-web node scripts/acceptance/delivery-smoke.mjs",
    "acceptance:phase3": "npm run ci:full && npm run acceptance:browse-live-proof && npm run acceptance:delivery-smoke",
    "ci:full": "node --import tsx scripts/audit/ci-full.ts",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@img/sharp-darwin-arm64": "^0.34.5",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
