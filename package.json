{
  "name": "grasseye-local-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "GrassEye phase-five final-delivery debugging local workbench",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "browser:verify": "node --import tsx scripts/acceptance/browser-extension-build.acceptance.ts",
    "browser:protocol:generate": "node src/lib/browser/protocol/generate-browser-protocol.mjs",
    "browser:build": "npm run browser:protocol:generate && node src/lib/browser/chrome-extension/build.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "acceptance:local-browser-terminal": "node --import tsx scripts/acceptance/local-browser-terminal-contract.acceptance.ts && node --import tsx scripts/acceptance/local-browser-property-model.acceptance.ts && node --import tsx scripts/acceptance/local-browser-rule-mutants.acceptance.ts && node --import tsx scripts/acceptance/local-runtime-browser-authority.acceptance.ts && node --import tsx scripts/acceptance/local-browser-auto-pairing.acceptance.ts",
    "acceptance:local-browser-release-identity": "node --import tsx scripts/acceptance/browser-extension-release-identity.acceptance.ts",
    "acceptance:browser-extension-build": "node --import tsx scripts/acceptance/browser-extension-build.acceptance.ts",
    "acceptance:gpt": "node --import tsx scripts/acceptance/gpt-exact-target.acceptance.ts",
    "internal:app-server": "node dist/src/app/server.js",
    "grasseye:start": "node --import tsx --env-file-if-exists=.env.local scripts/startup/launch-grasseye.mjs",
    "logs:inspect": "node --import tsx scripts/runtime-logs/inspect.ts",
    "internal:app-server:dev": "tsx src/app/server.ts",
    "acceptance:runtime-log-spine": "node --import tsx scripts/acceptance/runtime-log-redaction.acceptance.ts && node --import tsx scripts/acceptance/runtime-log-spine-v2.acceptance.ts && node --import tsx scripts/acceptance/runtime-log-spine-failure-matrix.acceptance.ts && node --import tsx scripts/acceptance/runtime-log-spine-ast-anti-escape.acceptance.ts",
    "acceptance:constitutional-boundary-anti-escape": "node --import tsx scripts/acceptance/constitutional-boundary-anti-escape.acceptance.ts",
    "acceptance:capability-governance": "node --import tsx scripts/acceptance/capability-governance.acceptance.ts",
    "acceptance:forensics-persistence-capability": "node --import tsx scripts/acceptance/forensics-persistence-capability.acceptance.ts",
    "audit:build": "node --import tsx scripts/audit/governance.ts build",
    "audit:projection:check": "node --import tsx scripts/audit/governance.ts projection",
    "quality:check": "node --import tsx scripts/audit/governance.ts quality",
    "acceptance:code-purity-zombie-deep": "node --import tsx scripts/acceptance/code-purity-zombie-deep.acceptance.ts",
    "lint": "npm run typecheck",
    "acceptance:app-shell-ui": "node --import tsx scripts/acceptance/app-shell-ui.acceptance.ts && node --import tsx scripts/acceptance/app-shell-localization.acceptance.ts && node --import tsx scripts/acceptance/app-shell-skill-registry.acceptance.ts",
    "acceptance:agent-product-skills": "node --import tsx scripts/acceptance/agent-product-skills.acceptance.ts",
    "acceptance:agent-production-runtime": "node --import tsx scripts/acceptance/agent-product-skills.acceptance.ts && node --import tsx scripts/acceptance/agent-production-runtime.acceptance.ts",
    "acceptance:agent-production-runtime:real-proof": "node --import tsx scripts/acceptance/agent-production-runtime.real-proof.ts",
    "acceptance:local-app-shell": "node --import tsx scripts/acceptance/local-app-shell.acceptance.ts",
    "proof:local-shell-current-runtime": "node --import tsx scripts/acceptance/local-shell-current-runtime.dynamic.ts",
    "acceptance:workbench-api-boundary": "node --import tsx scripts/acceptance/workbench-api-boundary.acceptance.ts",
    "acceptance:startup-entrypoint": "node --import tsx scripts/acceptance/startup-initialization-health.acceptance.ts && node --import tsx scripts/acceptance/startup-browser-artifact-sync.acceptance.ts",
    "acceptance:system-security": "node --import tsx scripts/acceptance/system-security.acceptance.ts",
    "production-runtime:cloud:enroll": "node --import tsx scripts/startup/production-runtime-cloud-enroll.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
