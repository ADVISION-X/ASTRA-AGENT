{
  "schemaVersion": 1,
  "specId": "runtime-log-spine.runtime-log-event-v2",
  "status": "active",
  "version": 3,
  "owner": "runtime-log-spine",
  "lawIds": [
    "LAW-RUNTIME-LOG-SPINE-001-V7",
    "LAW-RUNTIME-LOG-SPINE-002-V4",
    "LAW-RUNTIME-LOG-SPINE-003-V6"
  ],
  "specKind": "typed-contract",
  "contract": {
    "typeName": "RuntimeLogEventV2",
    "fields": {
      "authority": "authorityRef?,authorityHash?,evidenceRef?,evidenceHash?;hashes=sha256:64-lowercase-hex;durable-readonly-resolvable-only;commit-before-log;lease-checkpoint-by-job;outbox-by-idempotency-key-and-job",
      "common": "schemaVersion=2,eventId,emittedAt,producer,producerRunId,producerSeq,previousEventHash,eventHash,kind=event|span.started|span.terminal|error,traceId,owner,component,operation,visibility;additionalProperties=false",
      "failure": "kind=transport|authentication|contract|admission|dependency|storage|browser|provider|internal;code=innermost-active-typed-machine-code;nativeCause?=recursive-safe-network-allowlist;responsibleOwner;impact=BLOCKING|CONSEQUENTIAL|CLEANUP;causedByEventId?;httpStatus?=present-for-http-response;unknown-error-message-forbidden;additionalProperties=false",
      "integrity": "single-writer;producerSeq=1..n;first.previousEventHash=null;next.previousEventHash=prior.eventHash;eventHash=sha256(canonical-json-without-eventHash);cross-segment-continuity;normal-stop-final-event=PRODUCER_STOPPED;directory-source=direct-producer-child-segments-only;layout-outside-root-files-not-active;invalid-file-inside-active-layout-fails-closed;no-legacy-reader",
      "crossRepositoryBoundary": "same-existing-request_id-or-idempotency_key-as-boundaryId-on-both-sides;cloud.session-open-included;missing-opposite-source=BOUNDARY_SOURCE_INCOMPLETE+DIAGNOSIS_INCOMPLETE",
      "event": "kind=event;code;typedIdentity;authorityRef?;authorityHash?;evidenceRef?;evidenceHash?;additionalProperties=false",
      "error": "kind=error;failure;typedIdentity;authorityRef?;authorityHash?;evidenceRef?;evidenceHash?;additionalProperties=false",
      "spanStarted": "kind=span.started;spanId;parentSpanId?;boundaryId?;typedIdentity;additionalProperties=false",
      "spanTerminal": "kind=span.terminal;spanId;outcome=succeeded|failed|interrupted;durationMs;authorityRef?;authorityHash?;evidenceRef?;evidenceHash?;claimDiagnostics?;succeeded-forbids-failure;failed-or-interrupted-requires-failure;additionalProperties=false",
      "claimDiagnostics": "only-operation=cloud.claim-and-only-after-valid-Website-receipt;required-when-receipt-exists;fields-exactly=outcome,claimed_count,reason_codes;outcome=LEASE_GRANTED|NO_ELIGIBLE_JOB|CAPACITY_ZERO|CLAIM_BLOCKED|DRAINING;claimed_count=integer-0..10;LEASE_GRANTED-iff-claimed_count>0;reason_codes=array-0..32-of-machine-codes;additionalProperties=false;diagnostic-only-no-task-state-no-recovery-decision",
      "diagnosis": "read-only events, span structure, failure roots, authority references and atomic Browser evidence only;no task state, flow position, recovery decision, replay or persisted projection",
      "typedIdentity": "producer|request|job|job-attempt|lease|plugin-step|gpt-call|browser-command|browser-mutation|checkpoint|outbox;closed-discriminated-union;additionalProperties=false",
      "writeResult": "ok=true,event | ok=false,code,emergencyProjected;no-void;no-silent-catch"
    }
  }
}
