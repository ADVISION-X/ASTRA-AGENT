ry x="790" y="650" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab5" value="Geometry Guard&lt;br&gt;几何校准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1035" y="650" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab6" value="Mouse Click&lt;br&gt;鼠标点击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1280" y="650" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab7" value="Text Input&lt;br&gt;文本输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="770" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab8" value="Mouse Scroll&lt;br&gt;鼠标滚动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="770" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab9" value="Post-action Verification&lt;br&gt;动作后验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="545" y="770" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab10" value="AI&lt;br&gt;识别与判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fff7;strokeColor=#15803d;fontSize=15;fontFamily=Arial;fontStyle=0;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="790" y="770" width="205" height="88" as="geometry"/></mxCell><mxCell id="ab11" value="Forensics Persistence&lt;br&gt;证据固化" style="rounded=1;whiteSpace=wrap;htm