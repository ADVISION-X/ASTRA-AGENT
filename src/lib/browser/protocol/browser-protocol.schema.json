{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grasseye.browser.protocol.v1",
  "revision": 1,
  "controlFrameMaxBytes": 262144,
  "artifactChunkMaxBytes": 4194304,
  "commandAdmission": {
    "maxQueuedCommands": 64,
    "maxInFlightCommands": 1,
    "defaultDeadlineMs": 30000
  },
  "commandKinds": ["navigate", "dom-intent", "screenshot", "file-input", "wait", "close-target"],
  "requiredFrameFields": ["revision", "sequence", "authorityEpoch", "sourceChannelToken", "payload"],
  "additionalProperties": false
}
