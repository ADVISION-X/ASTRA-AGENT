{
  "manifest_version": 3,
  "name": "GrassEye Browser Runtime",
  "version": "3.0.0",
  "minimum_chrome_version": "120",
  "description": "Authenticated exact-target runtime for the GrassEye Browser infrastructure.",
  "key": "",
  "permissions": ["alarms", "debugger", "nativeMessaging", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.ae/*",
    "https://*.facebook.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
