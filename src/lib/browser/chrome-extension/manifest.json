{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "ASTRA Browser Authority",
  "version": "1.0.0",
  "description": "ASTRA-AGENT 独立工作台的固定目录本地浏览器授权扩展。",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "alarms"
  ],
  "action": {
    "default_title": "ASTRA 自动连接与精确 ChatGPT 认领状态",
    "default_popup": "pairing.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "key": ""
}
