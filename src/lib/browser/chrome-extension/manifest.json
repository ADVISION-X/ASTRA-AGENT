{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "GrassEye Browser Authority",
  "version": "1.0.0",
  "description": "GrassEye 工作台的固定目录本地浏览器授权扩展。",
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["debugger", "activeTab"],
  "action": { "default_title": "为 GrassEye 配对并认领当前操作员确认的标签页", "default_popup": "pairing.html" },
  "host_permissions": ["http://127.0.0.1/*"],
  "key": ""
}
