{
  "manifest_version": 3,
  "name": "GrassEye Browser Authority",
  "version": "0.2.0",
  "description": "Authenticated exact-target browser authority for the local GrassEye Workbench.",
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["debugger"],
  "action": { "default_title": "Claim this operator-approved target for GrassEye" },
  "host_permissions": [],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] },
  "key": ""
}
