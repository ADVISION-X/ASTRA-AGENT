    "ClaimRequestV6",
    "ClaimResponseV6",
    "ClaimBatchReceiptV6",
    "CloudExecutionGrantV6",
    "ExecutionFenceV6",
    "LeaseTimingV6",
    "LeaseReleaseV6",
    "LeaseRenewV6",
    "CheckpointV6",
    "ControlIntentV6",
    "TerminalCasV6",
    "HandoverV6",
    "MaterialReceiptV6",
    "ErrorEnvelopeV6"
